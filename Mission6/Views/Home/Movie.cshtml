@{
    ViewData["Title"] = "Home";
}
@model Mission6.Models.Movie

<div class="container">
    <h1 class="text-center">Add a Movie to Your Collection</h1>

    <form method="post" asp-action="SaveMovie">
        <div class="form-group">
            <label asp-for="Title">Title:</label>
            <input asp-for="Title" class="form-control" type="text" id="title" required>
        </div>

        <div class="form-group">
            <label asp-for="Year">Year Released:</label>
            <input asp-for="Year" class="form-control" type="number" id="year" min="1900" max="2025" required>
        </div>

        <div class="form-group">
            <label asp-for="Director">Director:</label>
            <input asp-for="Director" class="form-control" type="text" id="director" required>
        </div>

        <div class="form-group">
            <label asp-for="Rating">Rating:</label>
            <select asp-for="Rating" class="form-control" id="rating" required>
                <option value="">Select a Rating</option>
                <option value="G">G</option>
                <option value="PG">PG</option>
                <option value="PG-13">PG-13</option>
                <option value="R">R</option>
            </select>
        </div>

        <div class="form-group">
            <label asp-for="Edited">Edited:</label>
            <select asp-for="Edited" class="form-control" id="edited">
                <option value="">Select</option>
                <option value="true">Yes</option>
                <option value="false">No</option>
            </select>
        </div>

        <div class="form-group">
            <label asp-for="LentTo">Lent To:</label>
            <input asp-for="LentTo" class="form-control" type="text" id="lentTo">
        </div>

        <div class="form-group">
            <label asp-for="Notes">Notes (Max 25 characters):</label>
            <textarea asp-for="Notes" class="form-control" id="notes" maxlength="25"></textarea>
        </div>

        <button type="submit" class="btn btn-primary">Add Movie</button>
    </form>
</div>
